# Cloudflare Pages response headers

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# CSS/JS are versioned with ?v=..., so they can be cached for a year
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon-*.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/_templates/*
  X-Robots-Tag: noindex

# Company profile PDFs: reachable by direct link only, keep them out of search results
/VENTURO-Managed-Services.pdf
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600
/VENTURO-Dedicated-Team.pdf
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600
